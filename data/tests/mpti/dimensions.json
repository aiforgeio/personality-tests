  "explanations": {
    "G1": {
      "L": "TA 主要抓大方向，具体怎么做大多交给你自己发挥。",
      "M": "关键节点会介入，但不会顺手接管你整篇稿子。",
      "H": "从结构到表述都会过问，明显已经在帮你握方向盘。",
      "X": "微操上头，论文像是 TA 借你账号亲自写的。"
    },
    "G2": {
      "L": "目标设定偏佛系，先稳住节奏和生存状态最重要。",
      "M": "该推进会推进，但整体还在人类可持续范围内。",
      "H": "产出期待明显偏高，任务表通常比你预期更满。",
      "X": "项目优先级压过一切，你的人生安排默认给课题让路。"
    },
    "G3": {
      "L": "组会像随机掉落事件，导师平时存在感稀薄，通常只在想要结果时突然上线。",
      "M": "周更或双周更，属于比较正常的科研气候。",
      "H": "固定会之外还会加会，你得常备汇报模式。",
      "X": "组会、临时会、走廊会全开，你像随身携带一套答辩系统。"
    },
    "C1": {
      "L": "反馈基本对事不对人，不靠比较和话术制造压力。",
      "M": "偶尔会比较或施压，但还没到系统性操控。",
      "H": "冷热交替和比较式反馈已经有强度了，你常常拿不准自己到底行不行。",
      "X": "比较、打压、情绪操控一起上，你会怀疑自己是不是在被系统性 PUA。"
    },
    "C2": {
      "L": "反馈像情绪炸弹，先骂再说（或者骂完也不说），你主要在消化恐惧。",
      "M": "反馈清楚但冷淡，问题能找到答案，但情绪没人接。",
      "H": "批评里开始有安抚和陪跑感，你不会被一句话直接打进地心。",
      "X": "先接住你再拆问题，改稿过程甚至带一点定向疗愈效果。"
    },
    "C3": {
      "L": "脚踏实地型，TA 对未来的描述通常比你想得还朴素。",
      "M": "会给愿景和空间，但不至于句句都奔着改变世界去。",
      "H": "一个 baseline 就能延伸出一条大路线，饼已经明显开始发面。",
      "X": "你刚跑通 baseline，TA 已经开始给你讲顶会、项目和赛道版图，饼大到需要分期消化。"
    },
    "A1": {
      "L": "偏爱成熟路线，安全和可控优先于冒险与传奇。",
      "M": "愿意试新东西，但一定会给自己留退路。",
      "H": "新方向和高风险题目对 TA 很有吸引力，敢押但还算有判断。",
      "X": "题目像拍脑袋立项，风险不是一起评估出来的，是你被通知要去扛的。"
    },
    "A2": {
      "L": "学术规范是清晰红线，数据、引用和署名都卡得比较严。",
      "M": "总体正规，但在赶进度时会出现少量“灵活处理”。",
      "H": "底线已经开始松动，“先别放这个结果”“再处理一下数据”这类话会让人心里发虚。",
      "X": "不是听说灰色操作，是你亲手参与过挑结果、动数据或先投再说的流程。"
    },
    "A3": {
      "L": "资源嗅觉偏弱，很多机会主要还得学生自己找。",
      "M": "申请、合作、经费这些基本跟得上，够用但不奢侈。",
      "H": "TA 很会找项目和合作，关键时候总能把资源补上。",
      "X": "资源雷达接近军用级别，好机会常在正式通知前就被 TA 接上。"
    },
    "T1": {
      "L": "遇到问题时会一起拆解，手把手带你过关键卡点。",
      "M": "会给方向和框架，更多是扶着你自己走。",
      "H": "更强调独立解决，指导有但开始明显收手。",
      "X": "求助不只是往宇宙发信号，偶尔还会收到错误答案，最后只能靠自己收拾残局。"
    },
    "T2": {
      "L": "外部有压力时，TA 甚至会当场和你切割，锅和场面基本都由你来接。",
      "M": "会先把场面兜一下，但回头多半还是把压力完整转嫁给你。",
      "H": "大多数关键场合会先帮你兜一下，再内部复盘。",
      "X": "外部压力一来 TA 先站你前面，等安全了才和你聊怎么改。"
    },
    "T3": {
      "L": "情绪稳定得像块石头，去汇报前不需要先看天气预报。",
      "M": "忙起来会有点气压变化，但整体仍然可预测。",
      "H": "心情波动已经会传导到组里，去沟通前你开始需要先做心理建设。",
      "X": "你去办公室前得先打听 TA 今天心情，站在门口都要判断是进去还是撤退。"
    },
    "L1": {
      "L": "经费紧不只是紧，是买前要请示、买后要追责，报销像二次答辩。",
      "M": "基本够用，但每一笔都讲究性价比和理由完整。",
      "H": "合理支出通常不卡，关键投入不会因为钱反复拉扯。",
      "X": "经费和流程几乎无感，合理开支像刷到了一张长期通行证。"
    },
    "L2": {
      "L": "导师实体化率很高，办公室大概率能直接刷到人。",
      "M": "能约到，但通常需要提前排时间和一点调度能力。",
      "H": "见一面开始要靠预约和时机，不再是随到随聊。",
      "X": "导师的物理存在近似都市传说，见上一面要靠情报和运气。"
    },
    "L3": {
      "L": "边界感约等于零，周末深夜找你是默认设置。",
      "M": "偶尔会跨界打扰，但大多数时候还算知道分寸。",
      "H": "基本尊重作息，真有急事也知道先说句不好意思。",
      "X": "边界感优秀到会劝你按时休息，在学术圈里像稀有保护动物。"
    },
    "E1": {
      "L": "资源和机会分配基本公开透明，至少看得见规则。",
      "M": "虽然不至于明牌偏心，但隐约能感觉到谁更受宠。",
      "H": "好资源流向已经明显固化，组里的人基本都心里有数。",
      "X": "偏心不是暗流，是公开的宠爱排行榜。"
    },
    "E2": {
      "L": "署名基本按贡献来，你的劳动成果不会被悄悄挪走。",
      "M": "默认会挂导师名或通讯，学生的一作能不能稳住还得看组里规矩和期刊惯例。",
      "H": "署名表面讲贡献，实际上还得给导师、师兄师姐或合作方腾位置，你的话语权很有限。",
      "X": "你的一作和你的点子都可能在转身后改名换姓。"
    },
    "E3": {
      "L": "主要还是在做自己的课题，杂活有限，培养逻辑是正常的。",
      "M": "会被安排一些横向或琐事，但还没有压穿毕业主线。",
      "H": "大量时间花在与毕业不直接相关的事情上，学生身份已经开始兼职化。",
      "X": "你已经不是学生，是导师体系里的全职劳动力外加私人助理。"
    }
  },
