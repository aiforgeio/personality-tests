  "explanations": {
    "R1": {
      "L": "做科研主要是为了学位和饭碗，兴趣嘛……有一点但不多。",
      "M": "兴趣和现实各占一半，有时为了好奇心驱动，有时为了KPI驱动。",
      "H": "你做科研是因为真的觉得有趣，即使没有任何外部奖励也愿意钻研。"
    },
    "R2": {
      "L": "佛系选手，能毕业能续聘就谢天谢地了，卷不动也不想卷。",
      "M": "有追求但不拼命，稳健推进，不至于跟自己过不去。",
      "H": "瞄准顶刊/大基金/学术影响力，眼里有火，脚下有风。"
    },
    "R3": {
      "L": "做成熟方向，走别人验证过的路，安全第一。",
      "M": "偶尔尝试新方向，但不会把所有鸡蛋放在一个未知的篮子里。",
      "H": "专挑没人做过的方向，哪里荒芜哪里去，风险就是乐趣。"
    },
    "W1": {
      "L": "计划不如变化快，走到哪算哪，甘特图是什么能吃吗。",
      "M": "脑子里有个大框架，但细节嘛……到时候再说。",
      "H": "日程表排满，文件夹分类清楚，连实验记录本都编了目录。"
    },
    "W2": {
      "L": "差不多就行了，完美是好的敌人，先投再说。",
      "M": "会改几轮，但不会无限循环，能放手时就放手。",
      "H": "每一个图表、每一句话都要反复打磨，不到自己满意绝不投稿。"
    },
    "W3": {
      "L": "DDL是唯一的驱动力。没有截止日期，产出约等于零。",
      "M": "时松时紧，有时高产有时摸鱼，看心情和外部压力。",
      "H": "每天稳定产出，雷打不动，像自带节拍器的学术永动机。"
    },
    "S1": {
      "L": "能不合作就不合作，一个人干最省心，队友是最大的不确定性。",
      "M": "看情况，靠谱的人可以合作，不靠谱的人请远离我。",
      "H": "喜欢团队作战，觉得合作能碰撞出更多火花，人多力量大。"
    },
    "S2": {
      "L": "社恐型选手，会议能不去就不去，networking是什么酷刑。",
      "M": "有目的性地社交，认识该认识的人，不会为了社交而社交。",
      "H": "每个会都想去，走到哪聊到哪，通讯录比Zotero都满。"
    },
    "S3": {
      "L": "导师说啥就做啥，不敢反驳，听话是生存法则。",
      "M": "有想法会找机会沟通，但不会硬刚，讲究策略。",
      "H": "自己拿主意，导师是参考不是老板，有不同意见就直说。"
    },
    "M1": {
      "L": "被拒一次就怀疑人生，审稿意见是一把刀插在心上拔不出来。",
      "M": "难受归难受，但几天后能恢复，改完继续投。",
      "H": "拒稿是日常操作，逐条反驳完当天就改投，铁皮心脏。"
    },
    "M2": {
      "L": "觉得自己配不上现在的位置，迟早被发现是个水货——经典冒充者综合征。",
      "M": "有时自信有时心虚，取决于最近是被夸了还是被骂了。",
      "H": "清楚自己的能力和价值，不会因为一次失败就否定自己。"
    },
    "M3": {
      "L": "毕业焦虑/职称焦虑/生存焦虑，三座大山压得喘不过气。",
      "M": "偶尔焦虑，但大多数时候能控制住，不至于影响正常生活。",
      "H": "船到桥头自然直，焦虑也解决不了问题，不如先把今天的事做好。"
    },
    "K1": {
      "L": "文献越读越多，越读越不敢动手，总觉得还没准备好。",
      "M": "读几篇核心的就开始干活，边做边补充。",
      "H": "先出活再说，哪里卡了再去查，实践出真知。"
    },
    "K2": {
      "L": "写论文是酷刑。一段话改一天，一篇初稿写一月。",
      "M": "能写但痛苦，需要咖啡、音乐和仪式感来启动。",
      "H": "打开电脑就能写，文字对你来说不是障碍，下笔如有神。"
    },
    "K3": {
      "L": "扎实复现和改进已有工作，渐进主义是科学的正道。",
      "M": "在已有框架上做创新，不是颠覆性的但也有自己的贡献。",
      "H": "追求全新范式和方法，不甘心做别人框架里的填充物。"
    }
  },
